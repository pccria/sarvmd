# Auto detect text files and perform LF normalization on checkout/commit
* text=auto

# Explicitly declare text files you want to always be normalized and converted to native line endings on checkout
*.dart text eol=lf
*.cc text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.c text eol=lf
*.cmake text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.otf binary
*.ttf binary
*.pdf binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
